# ====================================================================
# BIẾN MÔI TRƯỜNG CẤU HÌNH HỆ THỐNG CRM (S1-08)
# Sao chép file này thành .env hoặc thiết lập trên OS / Container
# ====================================================================

# Cấu hình máy chủ gửi email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Tên người dùng SMTP (hỗ trợ cả SMTP_USER và SMTP_USERNAME)
SMTP_USER=user@example.com
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=your_app_password

# Email & tên người gửi hiển thị
SMTP_FROM=noreply@crmbanhang.vn
SMTP_FROM_NAME=CRM Bán Hàng
